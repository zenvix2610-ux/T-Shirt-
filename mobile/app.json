{
  "expo": {
    "name": "திகழ் Drifts",
    "slug": "thigazh-drifts",
    "scheme": "thigazhdrifts",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose an image for your custom T-shirt design."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0b3d32"
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.thigazhadrifts.store"
    },
    "android": {
      "package": "com.thigazhadrifts.store"
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
