ENV=development
SECRET_KEY=replace-with-a-long-random-string
DATABASE_URL=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ADMIN_EMAIL=admin@thigazhdrifts.com
# Set a unique secret locally to provision the first admin. Do not commit .env.
ADMIN_PASSWORD=
ADMIN_NAME=Store Admin
HASH_ITERATIONS=200000

# Google Sheets — service account JSON path and spreadsheet id.
# Never put this file in the frontend or mobile app.
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_SHEET_ID=
SYNC_WEBHOOK_SECRET=

# cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=

# Razorpay keys stay on the server. The key id is the only value sent to the browser.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
